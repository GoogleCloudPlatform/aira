# GCP Credentials - Point to a single service account JSON file
_GCP_STORAGE_CREDENTIALS=path-to-service-account.json
_GCP_BUCKET_CREDENTIALS=path-to-service-account.json
_GCP_STT_CREDENTIALS=path-to-service-account.json
_GCP_SM_CREDENTIALS=path-to-service-account.json
_GCP_BIGQUERY_CREDENTIALS=path-to-service-account.json
_GCP_FB_CREDENTIALS=path-to-service-account.json

# Database Configuration - Default for local development
_DATABASE_TEST_URI=postgresql+asyncpg://postgres:postgres@localhost:5433/postgres
_DATABASE_URI=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Application Settings
_EXPORT_TO=none
_LOG_LEVEL=DEBUG
_ENV=dev
_PROJECT_ID=<your-gcp-project-id>
_BUCKET_PATH=<your-gcp-bucket-name>
_ORIGIN=*
_BASE_URL=http://localhost/
_FRONT_BASE_URL=http://localhost/

# Looker Configuration
_LOOKER_HOST=<your-looker-host-url>
_LOOKER_SECRET=<your-looker-client-secret>
LOOKER=<your-looker-host-url>
LOOKER_GENERAL_DASHBOARD_ID=1
LOOKER_LEARNERS_DASHBOARD_ID=2

# BigQuery Configuration
_BQ_DATASET=dataset_lia
_BQ_TABLE_NAME=student_results

# Email & SendGrid Configuration
_SENDGRID_KEY=<your-sendgrid-api-key>
_FORGOT_PW_TEMPLATE=<your-sendgrid-template-id>
_SENDER_EMAIL=support@example.com
_SMTP_SERVER=smtp.sendgrid.net
_SMTP_USER=apikey
_SMTP_PASSWORD=<your-sendgrid-api-key-for-smtp>
_EMAIL_FROM=contact@example.com
_SMTP_PORT=587

# Gemini API Key
_GEMINI_API_KEY=<your-gemini-api-key>

# Firebase Configuration
API_URL=http://api.dev.localhost/api/v1/
FIREBASE_API_KEY=<your-firebase-api-key>
FIREBASE_AUTH_DOMAIN=<your-project-id>.firebaseapp.com
FIREBASE_PROJECT_ID=<your-project-id>
FIREBASE_APP_ID=<your-firebase-app-id>